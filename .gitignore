# Stockfish binary - CRITICAL to exclude
stockfish*
stockfish.exe
*.exe

# Environment
.env
.venv
venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs / OS
*.log
.DS_Store
Thumbs.db